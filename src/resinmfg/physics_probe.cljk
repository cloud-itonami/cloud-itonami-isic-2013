(ns resinmfg.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  tensile-test simulation over a fixed sweep and print ONE EDN map of the
  physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (SOUL.md, `.hermes/`) reads every tick. It
  is the only thing the bot may call \"measured\": each number below is
  derived from a time-stepped trajectory by `resinmfg.robotics`, never
  typed in. Output schema `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo      \"cloud-itonami/cloud-itonami-isic-2013\"
     :procedure \"...\"          ; the standard test procedure simulated
     :solver    \"physics-2d/world-step\"
     :runs      [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived   {...}           ; quantities computed ACROSS runs
     :count     n}              ; runs that produced numeric quantities

  `:count` is an evidence floor: the bot treats 0 as \"could not measure\",
  never as \"nothing out of tolerance\". Exit 0 when every run produced
  numbers, 2 when any run did not (the answer is then unusable, not
  negative)."
  (:require [resinmfg.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep-masses-kg
  "Effective participating masses (moving jaw + engaged specimen) swept
  each tick. 0.3 kg is the fixture the robotics tests pin; the others
  bracket it so a change in the solver shows up as a change in slope,
  not only in one point."
  [0.1 0.2 0.3 0.4 0.6])

(defn- run-one [mass-kg]
  (let [t (robotics/tensile-test-telemetry-for {:specimen-mass-kg mass-kg})]
    {:input {:specimen-mass-kg mass-kg}
     :quantities t
     :out-of-tolerance? (robotics/tensile-test-out-of-tolerance? t)}))

(defn- load-at [mass-kg]
  (:sim-tensile-load-n (robotics/tensile-test-telemetry-for {:specimen-mass-kg mass-kg})))

(defn min-passing-mass-kg
  "Smallest effective mass whose simulated peak tensile load reaches
  `robotics/min-tensile-load-n`, by bisection over the REAL simulation
  (load is monotone in mass at fixed speed/travel -- pinned by
  `robotics-test`). nil when the bracket does not straddle the floor."
  ([] (min-passing-mass-kg 0.001 10.0 40))
  ([lo hi iters]
   (let [floor robotics/min-tensile-load-n]
     (when (and (< (load-at lo) floor) (>= (load-at hi) floor))
       (loop [lo lo hi hi i 0]
         (if (>= i iters)
           hi
           (let [mid (/ (+ lo hi) 2.0)]
             (if (>= (load-at mid) floor)
               (recur lo mid (inc i))
               (recur mid hi (inc i))))))))))

(defn probe []
  (let [runs (mapv run-one sweep-masses-kg)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-tensile-load-n])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2013"
     :procedure "ASTM D638 / ASTM D412 specimen tensile test (robot tensile-test cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:min-tensile-load-n robotics/min-tensile-load-n
               :min-passing-specimen-mass-kg (min-passing-mass-kg)}
     :count (count (filter numeric? runs))
     :expected (count sweep-masses-kg)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
